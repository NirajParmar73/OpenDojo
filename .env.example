# Production tenant routing. Leave empty for single-domain mode.
# Example: NUXT_TENANT_BASE_DOMAIN=opendojo.example.com
NUXT_TENANT_BASE_DOMAIN=
# Client-visible copy used to select the correct manifest and cross-app links.
NUXT_PUBLIC_TENANT_BASE_DOMAIN=

# Enable only after the app, platform, portal, and wildcard DNS/TLS records all
# point to this deployment. Sessions are deliberately host-only.
NUXT_ENFORCE_APP_SUBDOMAINS=false

# Public legal and customer-support details. Set these before production launch.
NUXT_PUBLIC_LEGAL_ENTITY_NAME=OpenDojo
NUXT_PUBLIC_SUPPORT_EMAIL=opendojos@gmail.com
NUXT_PUBLIC_APP_URL=https://app.your-domain.com
NUXT_PUBLIC_SUPPORT_PHONE=
NUXT_PUBLIC_LEGAL_ADDRESS=

# Generate a strong 32+ character session secret for production.
NUXT_SESSION_PASSWORD=

# PostgreSQL connection string. Keep the real value in .env or your host's secret store.
# Example: DATABASE_URL=postgresql://postgres:password@localhost:5432/opendojo
DATABASE_URL=

# Development only. Never enable this in production.
NUXT_ENABLE_TEST_PLAN_CHANGES=false

# Razorpay Checkout. Test keys begin with rzp_test_; use Live Mode keys only
# in your production secret store. Never commit a key secret.
NUXT_RAZORPAY_KEY_ID=
NUXT_RAZORPAY_KEY_SECRET=

# Browser push notifications. Generate one permanent key pair with
# `pnpm push:generate-keys`; changing it invalidates existing subscriptions.
NUXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
NUXT_WEB_PUSH_PRIVATE_KEY=
NUXT_WEB_PUSH_SUBJECT=mailto:opendojos@gmail.com

# Strong secret used by the hosting scheduler to dispatch due notifications.
NUXT_NOTIFICATION_CRON_SECRET=

# Comma-separated email addresses allowed to use /platform. Keep this secret.
PLATFORM_ADMIN_EMAILS=owner@your-domain.com
